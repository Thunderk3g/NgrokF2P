{
  "name": "local-file-transfer",
  "version": "1.0.0",
  "description": "Local network file transfer system",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "client": "cd client && npm start",
    "dev:full": "concurrently \"npm run dev\" \"npm run client\"",
    "tunnel": "ngrok http 3001"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "ip": "^1.1.8",
    "multer": "^1.4.5-lts.1",
    "ngrok": "^5.0.0-beta.2",
    "qrcode": "^1.5.3",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2"
  }
}
